# Optional LLM goal interpreter. Copy to .env; server.py loads it automatically.
# Explicit environment variables override values in .env.
WORKER_API_KEY=your-provider-key
WORKER_MODEL=your-json-capable-chat-model
WORKER_API_BASE=https://api.openai.com/v1
